library(zoo)
library(e1071)
install.packages("e1071")
library(zoo)
library(e1071)
#====================================================
# Load datasets
#====================================================
features <- read.csv(
"C:/A-CMSI research/Data/features.csv"
)
vt_data <- read.csv(
"C:/A-CMSI research/Data/Main components for A CMSI/V_component.csv"
)
#====================================================
# Merge on Date
#====================================================
data <- merge(features, vt_data, by = "Date")
#====================================================
# Create NEW HMM Dataset
#====================================================
HMM_dataset <- data.frame(
Date = data$Date,
# 1. Daily SPY Log Returns
Return = data$spy_ret,
# 2. Normalized GARCH Volatility
V_t = data$SPY_V,
# 3. 21-Day Rolling Volatility
RollingVol21 = sqrt(data$roll_var_spy),
# 4. 21-Day Rolling Skewness
RollingSkew21 = rollapply(
data$spy_ret,
width = 21,
FUN = skewness,
fill = NA,
align = "right"
),
# 5. Drawdown
Drawdown = (data$SPY - cummax(data$SPY)) /
cummax(data$SPY),
# 6. Volatility of Volatility
VolOfVol = rollapply(
data$SPY_V,
width = 21,
FUN = sd,
fill = NA,
align = "right"
),
# 7. Cross-Asset Correlation
C_t = rowMeans(
data[, c(
"corr_aapl_msft",
"corr_aapl_spy",
"corr_msft_spy"
)],
na.rm = TRUE
)
)
#====================================================
# Remove incomplete rows
#====================================================
HMM_dataset <- na.omit(HMM_dataset)
#====================================================
# Save
#====================================================
write.csv(
HMM_dataset,
"C:/A-CMSI research/Data/HMM_dataset.csv",
row.names = FALSE
)
#====================================================
# Check
#====================================================
head(HMM_dataset)
str(HMM_dataset)
summary(HMM_dataset)
